# Discord user ID of the bot owner (optional, falls back to guild owner/admin)
BotOwnerId=

# Discord bot token
# Create a bot at https://discord.com/developers/applications
BotToken=your_bot_token_here

# Discord channel name the bot listens in
ChatChannel=general

# Default personality when the bot starts
# Options: tama, saki
DefaultPersonality=tama

# Prefix for legacy text commands
CommandPrefix=!

# 1-in-N chance to reply in non-chat channels when not named
ReplyChance=6

# Hours between Discord activity/status rotations
ActivityHours=12

# Ollama model to use for AI responses (optional)
OllamaModel=gemma4

# Ollama HTTP endpoint (also accepts standard OLLAMA_HOST)
OllamaHost=http://localhost:11434

# Local music directory for /play_music
SongsDir=Songs

# Seconds before leaving a voice channel when nobody is left
AloneDisconnectSeconds=60

# IANA timezone for the daily quiz schedule
QuizTimezone=US/Arizona

# Optional extra directory of game names for Discord presence (Steam common/)
SteamGamesDir=
