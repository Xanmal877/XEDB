# XEDB instance environment — copy to <instance home>/.env and fill in.
# Secrets and runtime knobs only. Characters live in personality.yaml.

# ---- Discord ----
# Create a bot at https://discord.com/developers/applications
BotToken=
# Optional. Falls back to the guild owner/admin if unset.
BotOwnerId=
# Channel the bot chats in (name, not ID)
ChatChannel=general
# Which personality from personality.yaml this instance uses
DefaultPersonality=tama

# ---- Ollama ----
# Local daemon. Leave alone unless you run Ollama somewhere else.
OllamaHost=http://localhost:11434
# Ollama Cloud endpoint
OllamaCloudHost=https://ollama.com
# Required for `endpoint: cloud` in personality.yaml. https://ollama.com/settings/keys
OllamaApiKey=

# ---- Fallback providers (used only when the primary model fails) ----
# OpenAI-compatible endpoint used for the `codex` provider
OpenAIApiKey=
OpenAIBaseUrl=https://api.openai.com/v1
CodexModel=gpt-5.3-codex
# Cheap fallback used as the last link in the chain
LunaApiKey=
LunaBaseUrl=
LunaModel=gpt-5.6-luna

# ---- Behaviour ----
CommandPrefix=!
# 1-in-N chance the bot replies to an unaddressed message
ReplyChance=6
# Activity rotation period, in hours
ActivityHours=12
# Folder for /play_music sources (relative paths resolve to the instance home)
SongsDir=Songs
# Timezone for the daily quiz reset
QuizTimezone=US/Arizona
# Optional: folder holding local Steam game files
SteamGamesDir=
# Leave a voice channel after this many seconds alone
AloneDisconnectSeconds=60
